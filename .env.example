SPRING_PROFILES_ACTIVE=local
BACKEND_BASE_URL=http://127.0.0.1:8080
APP_ENVIRONMENT=local
FRONTEND_IMAGE=ghcr.io/example-owner/portfolio-frontend
BACKEND_IMAGE=ghcr.io/example-owner/portfolio-backend
IMAGE_TAG=sha-0000000000000000000000000000000000000000
POSTGRES_PORT=5432
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
DB_PASSWORD=replace-with-environment-secret
FILE_STORAGE_ROOT=storage/dev
LOG_PATH=build/logs
SESSION_COOKIE_NAME=PORTFOLIO_SESSION
SESSION_IDLE_TIMEOUT=8h
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=portfolio@example.com
MAIL_FROM=portfolio@example.com
MAIL_APP_PASSWORD=replace-with-environment-secret
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MONITORING_ENABLED=false
MONITORING_CONNECT_TIMEOUT=2s
MONITORING_REQUEST_TIMEOUT=3s
MONITORING_RETRY_DELAY=500ms
PORTFOLIO_FRONTEND_HEALTH_URL=http://frontend:3000/healthz
PORTFOLIO_BACKEND_HEALTH_URL=http://backend:8080/actuator/health
KYVC_FRONTEND_HEALTH_URL=https://dev-kyvc.example.com/healthz
KYVC_BACKEND_HEALTH_URL=https://dev-kyvc.example.com/actuator/health
KYVC_CORE_HEALTH_URL=https://dev-kyvc.example.com/core/health
SHKUTRACK_HEALTH_URL=https://dev-shkutrack.example.com/healthz
SMOKE_FRONTEND_BASE_URL=
SMOKE_API_BASE_URL=
