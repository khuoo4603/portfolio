# 실행 환경
SPRING_PROFILES_ACTIVE=local
BACKEND_BASE_URL=http://127.0.0.1:8080
APP_ENVIRONMENT=local

# Public canonical 및 공유 이미지 Origin
PUBLIC_SITE_URL=http://127.0.0.1:3000

# 데이터베이스
POSTGRES_PORT=5432
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
DB_PASSWORD=replace-with-environment-secret

# 파일 및 로그
FILE_STORAGE_ROOT=../storage/dev
LOG_PATH=build/logs

# 세션
SESSION_COOKIE_NAME=PORTFOLIO_SESSION
SESSION_IDLE_TIMEOUT=8h

# 메일
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=portfolio@example.com
MAIL_FROM=portfolio@example.com
MAIL_APP_PASSWORD=replace-with-environment-secret
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# 배포 Smoke Test
SMOKE_FRONTEND_BASE_URL=https://dev.khuoo.com
SMOKE_API_BASE_URL=https://dev-api.khuoo.com
